# RECO Platform - API Key Configuration
# Copy this file to .env and fill in your API keys

# ==========================================
# STEP 1: AI Hardware Advisor (Generative AI)
# ==========================================
# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Alternative: https://platform.openai.com/)
OPENAI_API_KEY=

# ==========================================
# STEP 2: Live Multi-Currency Conversion
# ==========================================
# ExchangeRate-API Key (https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=

# ==========================================
# STEP 3: Live Retailer Prices & Search
# ==========================================
# RapidAPI Key (https://rapidapi.com/)
RAPIDAPI_KEY=

# SerpAPI Key for Google Shopping (https://serpapi.com/)
SERPAPI_KEY=

# Keepa API Key for Amazon History (https://keepa.com/)
KEEPA_API_KEY=

# ==========================================
# STEP 4: Student Verification & User Auth
# ==========================================
# Firebase Web API Key (https://console.firebase.google.com/)
FIREBASE_API_KEY=

# ==========================================
# STEP 5: Cloud Database & Persistence
# ==========================================
# Supabase / PostgreSQL Connection String
DATABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_KEY=
